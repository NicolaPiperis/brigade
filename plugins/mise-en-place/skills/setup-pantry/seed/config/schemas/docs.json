{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pantry/config/schemas/docs.json",
  "title": "Docs document",
  "description": "Frontmatter of the documents in core/docs/: overview.md at product, module and feature level, topic.md at topic level. Vocabulary membership is checked by the validator against config/vocabulary/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["level", "product", "created", "last_verified"],
  "properties": {
    "level": { "enum": ["product", "module", "feature", "topic"] },
    "product": { "type": "string" },
    "module": { "type": "string" },
    "feature": { "type": "string" },
    "topic": { "type": "string" },
    "tags": { "type": "array" },
    "created": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" }
  },
  "allOf": [
    { "if": { "properties": { "level": { "const": "product" } } },
      "then": { "allOf": [ { "not": { "required": ["module"] } }, { "not": { "required": ["feature"] } }, { "not": { "required": ["topic"] } } ] } },
    { "if": { "properties": { "level": { "const": "module" } } },
      "then": { "required": ["module"], "allOf": [ { "not": { "required": ["feature"] } }, { "not": { "required": ["topic"] } } ] } },
    { "if": { "properties": { "level": { "const": "feature" } } },
      "then": { "required": ["module", "feature"], "not": { "required": ["topic"] } } },
    { "if": { "properties": { "level": { "const": "topic" } } },
      "then": { "required": ["module", "feature", "topic"] } }
  ]
}
