{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pantry/config/schemas/technical.json",
  "title": "Technical entry",
  "description": "Frontmatter of the entries in core/technical/ (gotcha, decision, pattern). Level documents (map.md, rules.md, structure.md) carry no frontmatter. Vocabulary membership is checked by the validator against config/vocabulary/, so names are not listed here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "level", "project", "created", "last_verified"],
  "properties": {
    "type": { "enum": ["gotcha", "decision", "pattern"] },
    "level": { "enum": ["project", "module", "feature"] },
    "project": { "type": "string" },
    "module": { "type": "string" },
    "feature": { "type": "string" },
    "tags": { "type": "array" },
    "created": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" }
  },
  "allOf": [
    { "if": { "properties": { "level": { "const": "project" } } },
      "then": { "allOf": [ { "not": { "required": ["module"] } }, { "not": { "required": ["feature"] } } ] } },
    { "if": { "properties": { "level": { "const": "module" } } },
      "then": { "required": ["module"], "not": { "required": ["feature"] } } },
    { "if": { "properties": { "level": { "const": "feature" } } },
      "then": { "required": ["module", "feature"] } }
  ]
}
